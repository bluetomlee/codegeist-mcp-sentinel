{
  "name": "mcp-sentinel",
  "version": "0.1.0",
  "description": "Forge app + Rovo agent that audits MCP server tool definitions for tool poisoning and prompt injection.",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
